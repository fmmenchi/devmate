{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fmmenchi/devmate/schemas/plan.schema.json",
  "title": "plan.json",
  "description": "The planning step's output: one plan, or a proposal to split the issue. Exactly one of plan and split is present, and it matches outcome.",
  "type": "object",
  "required": ["schemaVersion", "issue", "outcome"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": ["plan", "split"]
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "split": {
      "$ref": "#/$defs/split"
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "plan"
        },
        "plan": true,
        "split": false
      },
      "required": ["plan"]
    },
    {
      "properties": {
        "outcome": {
          "const": "split"
        },
        "split": true,
        "plan": false
      },
      "required": ["split"]
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "object",
      "required": [
        "approach",
        "alternatives",
        "files",
        "tests",
        "verification",
        "outOfScope",
        "assumptions",
        "estimatedDiffLines"
      ],
      "additionalProperties": false,
      "properties": {
        "approach": {
          "$ref": "#/$defs/text"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["approach", "rejectedBecause"],
            "additionalProperties": false,
            "properties": {
              "approach": {
                "$ref": "#/$defs/text"
              },
              "rejectedBecause": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "change", "new"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/text"
              },
              "change": {
                "$ref": "#/$defs/text"
              },
              "new": {
                "type": "boolean"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "proves", "failsBefore"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/text"
              },
              "proves": {
                "$ref": "#/$defs/text"
              },
              "failsBefore": {
                "type": "boolean"
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "estimatedDiffLines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "split": {
      "type": "object",
      "required": ["criterion", "evidence", "issues", "cost"],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "enum": [1, 2, 3, 4]
        },
        "evidence": {
          "$ref": "#/$defs/text"
        },
        "issues": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["key", "title", "body", "acceptance", "dependsOn"],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "body": {
                "$ref": "#/$defs/text"
              },
              "acceptance": {
                "$ref": "#/$defs/text"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "cost": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
